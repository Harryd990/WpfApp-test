<Window x:Class="WpfApp_test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_test"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- Define two columns -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar in first column-->
        
        
        
        <StackPanel Grid.Column="0" Background="DarkGray" Orientation="Vertical">
            <Button x:Name="BtnDrawLine" Content="Drawline" Margin="10" Click="BtnDrawLine_Click"/>
            <Button x:Name="BtnDrawBox" Content="DrawBox" Margin="10" Click="BtnDrawBox_Click"/>
            <Button x:Name="BtnDrawGrid" Content="DrawGrid" Margin="10" Click="BtnDrawGrid_Click"/>
            <ComboBox x:Name="cboSelectThing" Width="120"/>
            <Slider x:Name="SlideWidth" Width="120" Value="0"/>
            <Slider x:Name="SlideHight" Width="120"/>
        </StackPanel>


        <!-- Canvas on the right hand side-->
        <Canvas x:Name="myCanvas" Grid.Column="1"/>



    </Grid>
</Window>
